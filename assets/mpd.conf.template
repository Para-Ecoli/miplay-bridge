# 妙播桥 · MPD 配置模板
#
# 由自研外壳 cmd/miplay-bridge 在启动时渲染为 /etc/mpd.conf。
# 变量占位符使用 Go text/template 语法，请勿手工修改容器内生成的文件。
#
# 关键约束（沿用实机验证结论）：
#   · device "hw:0,0"        模拟声卡唯一立体声输出通路（3.5mm 耳机孔 / USB DAC）
#   · mixer_type "null"      妙播桥不提供音量控制：MPD 忽略 setvol 等音量命令，
#                             增益固定为满量程，系统的输出幅度由上游播放端决定
#   · auto_resample "no"     设备原生支持 44.1/48/96/192k，不做重采样，保持 bit-perfect
#   · 不设置 format          让 MPD 按曲目实际采样率打开设备（设死会强制重采样）
#   · bind_to_address 127.0.0.1  MPD 控制口只给同容器的自研外壳使用，不对局域网暴露
#
# 注意：妙播实时管线不经 MPD（ffmpeg | aplay 直出），本配置服务 DLNA 投音与
# REST API 的 URL 播放。

music_directory     "{{.MusicDirectory}}"
playlist_directory  "{{.PlaylistDirectory}}"
db_file             "{{.DBFile}}"
state_file          "{{.StateFile}}"
bind_to_address     "{{.BindAddress}}"
port                "{{.Port}}"
{{if .LogFile}}log_file            "{{.LogFile}}"
{{end}}filesystem_charset  "UTF-8"
auto_update         "no"
restore_paused      "no"

audio_output {
    type            "alsa"
    name            "妙播桥"
    device          "{{.Device}}"
    mixer_type      "null"
    auto_resample   "no"
}
